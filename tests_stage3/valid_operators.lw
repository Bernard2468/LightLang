int a = 10;
int b = 3;
float f = 2.5;
bool p = true;
bool q = false;
string first = "Light";
string second = "Lang";
int mod = a % b;
float mixed = a / f;
bool compare = a >= b;
bool equalNumeric = a == f;
bool equalBool = p != q;
bool logic = p && !q;
string joined = first + second;
print(mod);
print(mixed);
print(compare);
print(equalNumeric);
print(equalBool);
print(logic);
print(joined);
