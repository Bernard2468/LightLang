LIGHTLANG_BYTECODE 2
COUNT 42
PUSH_STRING 0 13 "" "\"LightLang\""
CALL 34 13 "1" "welcome"
STORE_TEMP 0 13 "" "%t1"
LOAD_TEMP 0 13 "" "%t1"
PRINT 0 13 "" ""
PUSH_INT 0 14 "" "6"
CALL 11 14 "1" "factorial"
STORE_TEMP 0 14 "" "%t2"
LOAD_TEMP 0 14 "" "%t2"
PRINT 0 14 "" ""
HALT 0 0 "" ""
BIND_PARAM 0 1 "int" "n"
LOAD 0 2 "" "n"
PUSH_INT 0 2 "" "1"
LESS_EQUAL 0 2 "" ""
STORE_TEMP 0 2 "" "%t3"
LOAD_TEMP 0 2 "" "%t3"
JUMP_IF_FALSE 21 2 "" ""
PUSH_INT 0 3 "" "1"
RETURN 0 3 "int" ""
JUMP 34 2 "" ""
LOAD 0 5 "" "n"
PUSH_INT 0 5 "" "1"
SUBTRACT 0 5 "" ""
STORE_TEMP 0 5 "" "%t4"
LOAD_TEMP 0 5 "" "%t4"
CALL 11 5 "1" "factorial"
STORE_TEMP 0 5 "" "%t5"
LOAD 0 5 "" "n"
LOAD_TEMP 0 5 "" "%t5"
MULTIPLY 0 5 "" ""
STORE_TEMP 0 5 "" "%t6"
LOAD_TEMP 0 5 "" "%t6"
RETURN 0 5 "int" ""
BIND_PARAM 0 9 "string" "name"
PUSH_STRING 0 10 "" "\"Welcome, \""
LOAD 0 10 "" "name"
ADD 0 10 "" ""
STORE_TEMP 0 10 "" "%t7"
LOAD_TEMP 0 10 "" "%t7"
RETURN 0 10 "string" ""
HALT 0 0 "" ""
