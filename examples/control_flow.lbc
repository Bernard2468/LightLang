LIGHTLANG_BYTECODE 2
COUNT 40
DECLARE 0 2 "int" "number"
PUSH_INT 0 2 "" "5"
STORE 0 2 "" "number"
DECLARE 0 3 "int" "total"
PUSH_INT 0 3 "" "0"
STORE 0 3 "" "total"
LOAD 0 5 "" "number"
PUSH_INT 0 5 "" "0"
GREATER 0 5 "" ""
STORE_TEMP 0 5 "" "%t1"
LOAD_TEMP 0 5 "" "%t1"
JUMP_IF_FALSE 25 5 "" ""
LOAD 0 6 "" "total"
LOAD 0 6 "" "number"
ADD 0 6 "" ""
STORE_TEMP 0 6 "" "%t2"
LOAD_TEMP 0 6 "" "%t2"
STORE 0 6 "" "total"
LOAD 0 7 "" "number"
PUSH_INT 0 7 "" "1"
SUBTRACT 0 7 "" ""
STORE_TEMP 0 7 "" "%t3"
LOAD_TEMP 0 7 "" "%t3"
STORE 0 7 "" "number"
JUMP 6 5 "" ""
LOAD 0 10 "" "total"
PUSH_INT 0 10 "" "15"
EQUAL 0 10 "" ""
STORE_TEMP 0 10 "" "%t4"
LOAD_TEMP 0 10 "" "%t4"
JUMP_IF_FALSE 34 10 "" ""
PUSH_STRING 0 11 "" "\"sum verified\""
PRINT 0 11 "" ""
JUMP 36 10 "" ""
PUSH_STRING 0 13 "" "\"unexpected result\""
PRINT 0 13 "" ""
LOAD 0 16 "" "total"
PRINT 0 16 "" ""
HALT 0 0 "" ""
HALT 0 0 "" ""
